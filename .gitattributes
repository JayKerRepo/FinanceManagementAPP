# Git LFS configuration for large files (if needed)
# Note: .next directory should be ignored, not tracked with LFS

# If you need to track large files in the future, uncomment and configure:
# *.pack filter=lfs diff=lfs merge=lfs -text
# *.pack.gz filter=lfs diff=lfs merge=lfs -text

# Ensure .next is never tracked
.next/** -text linguist-generated=true

# Build artifacts should not be tracked
*.tsbuildinfo -text linguist-generated=true
node_modules/** -text linguist-generated=true

